HM_ENV=dev
HM_HTTP_ADDR=0.0.0.0:8000
HM_DB_DRIVER=mysql
# 本地：显式 DSN。云托管可留空，改由自动注入的 MYSQL_* 拼装。
HM_DB_DSN=hm:hm_dev_password@tcp(127.0.0.1:3306)/hm_lesson?charset=utf8mb4&parseTime=true&loc=UTC
# 云托管兼容（HM_DB_DSN 为空时生效；库名缺省 hm_lesson）
# MYSQL_ADDRESS=10.0.0.8:3306
# MYSQL_USERNAME=hm
# MYSQL_PASSWORD=change-me
# MYSQL_DATABASE=hm_lesson
# HM_DB_NAME=hm_lesson
HM_JWT_SECRET=replace-with-32-byte-random
# 云托管有 COS_BUCKET/COS_REGION 时自动用 cloud，无需再设 HM_STORAGE_*
HM_STORAGE_DRIVER=minio
HM_STORAGE_BUCKET=hm-dev
HM_STORAGE_REGION=ap-shanghai
HM_WX_APP_ID=
HM_WX_APP_SECRET=
# 微信订阅消息模板（未配置则整条链路 no-op，只发站内通知）。fields 是「模板关键词 -> 变量名」。
# 可用变量：title / student / date / due_at / score
# HM_WX_SUBSCRIBE_TEMPLATES={"task_published":{"id":"","fields":{"thing1":"title","time2":"due_at"}},"task_reviewed":{"id":"","fields":{"thing1":"title","number2":"score"}},"task_returned":{"id":"","fields":{"thing1":"title","thing2":"student"}}}
HM_WX_TMPL_LANG=zh_CN
HM_WX_MP_STATE=formal
HM_LOG_LEVEL=info
HM_TIMEZONE=Asia/Shanghai

# 首次启动创建第一个 owner（仅当库中无老师）；创建后请删除并改密
HM_BOOTSTRAP_NAME=鹤鸣老师
HM_BOOTSTRAP_PHONE=13800000000
HM_BOOTSTRAP_PASSWORD=change-me-8chars
